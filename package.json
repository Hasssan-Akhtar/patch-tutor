{
  "name": "patch-tutor",
  "displayName": "Patch Tutor",
  "description": "Turns your git changes into short lessons: inline explanations and quizzes on the code you changed.",
  "version": "0.0.1",
  "publisher": "patch-tutor",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#13202B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/patch-tutor"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "patchTutor.listStagedHunks",
        "title": "List staged hunks",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.explainStagedChanges",
        "title": "Explain staged changes",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.chooseProvider",
        "title": "Choose provider",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.chooseModel",
        "title": "Choose model",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.testConnection",
        "title": "Test connection",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.dev.runPromptEvals",
        "title": "Run prompt evals (dev)",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.explainHunk",
        "title": "Explain this change",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quizHunk",
        "title": "Quiz me",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.thread.deeper",
        "title": "Go deeper",
        "category": "Patch Tutor",
        "icon": "$(zoom-in)"
      },
      {
        "command": "patchTutor.thread.simpler",
        "title": "Simpler",
        "category": "Patch Tutor",
        "icon": "$(zoom-out)"
      },
      {
        "command": "patchTutor.thread.quiz",
        "title": "Quiz me",
        "category": "Patch Tutor",
        "icon": "$(mortar-board)"
      },
      {
        "command": "patchTutor.thread.dismiss",
        "title": "Dismiss",
        "category": "Patch Tutor",
        "icon": "$(close)"
      },
      {
        "command": "patchTutor.quiz.submit",
        "title": "Submit answer",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quiz.showAnswer",
        "title": "Show answer",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quiz.skip",
        "title": "Skip",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.thread.reportWrong",
        "title": "This is wrong",
        "category": "Patch Tutor",
        "icon": "$(report)"
      },
      {
        "command": "patchTutor.openReports",
        "title": "Open wrong-answer reports",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.resetProgress",
        "title": "Reset progress",
        "category": "Patch Tutor",
        "icon": "$(clear-all)"
      },
      {
        "command": "patchTutor.showProgress",
        "title": "Show progress",
        "category": "Patch Tutor",
        "icon": "$(graph)"
      },
      {
        "command": "patchTutor.quiz.moveToChat",
        "title": "Move to chat",
        "category": "Patch Tutor",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "patchTutor.setApiKey",
        "title": "Set API key",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.openModelSettings",
        "title": "Model settings",
        "category": "Patch Tutor",
        "icon": "$(gear)"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Patch Tutor",
        "description": "Turn your own git changes into short lessons.",
        "steps": [
          {
            "id": "model",
            "title": "Pick a model",
            "description": "Choose where explanations come from: models already in VS Code, or your own key.\n[Open model settings](command:patchTutor.openModelSettings)",
            "media": {
              "markdown": "media/walkthrough/model.md"
            },
            "completionEvents": [
              "onCommand:patchTutor.openModelSettings"
            ]
          },
          {
            "id": "explain",
            "title": "Explain a change",
            "description": "Edit a file in a git repo, then click **Explain this change** above the hunk.\n[Explain staged changes](command:patchTutor.explainStagedChanges)",
            "media": {
              "markdown": "media/walkthrough/explain.md"
            },
            "completionEvents": [
              "onCommand:patchTutor.explainHunk",
              "onCommand:patchTutor.explainStagedChanges"
            ]
          },
          {
            "id": "quiz",
            "title": "Quiz yourself",
            "description": "Click **Quiz me** on a hunk and answer a few short questions.\n[Open the Quiz chat](command:patchTutor.chat.focus)",
            "media": {
              "markdown": "media/walkthrough/quiz.md"
            },
            "completionEvents": [
              "onCommand:patchTutor.quizHunk",
              "onCommand:patchTutor.thread.quiz",
              "onView:patchTutor.chat"
            ]
          },
          {
            "id": "progress",
            "title": "Track your progress",
            "description": "See which concepts you have mastered and which need practice.\n[Show progress](command:patchTutor.showProgress)",
            "media": {
              "markdown": "media/walkthrough/progress.md"
            },
            "completionEvents": [
              "onCommand:patchTutor.showProgress",
              "onView:patchTutor.progress"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Patch Tutor",
      "properties": {
        "patchTutor.provider": {
          "type": "string",
          "enum": [
            "vscodeLm",
            "anthropic",
            "openaiCompatible",
            "ollama"
          ],
          "enumItemLabels": [
            "VS Code models (Copilot and others)",
            "Anthropic",
            "OpenAI-compatible",
            "Ollama (local)"
          ],
          "enumDescriptions": [
            "GitHub Copilot or any model another extension adds to VS Code. No API key needed.",
            "Claude models with your Anthropic API key.",
            "OpenAI, OpenRouter, Groq, LM Studio or any server with the OpenAI chat completions API.",
            "A model running locally in Ollama. Nothing leaves your machine."
          ],
          "default": "vscodeLm",
          "markdownDescription": "Which language model provider explains and quizzes your changes. Easiest to change from the **⚙ model settings** in the Patch Tutor chat. API keys are stored in VS Code's secret storage, never here."
        },
        "patchTutor.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model id for the provider. Leave empty for the provider's default (Anthropic: `claude-opus-5-5`; VS Code models: a Copilot model if one is available, otherwise the first model). OpenAI-compatible servers and Ollama need a model name."
        },
        "patchTutor.contextTokenBudget": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 100000,
          "markdownDescription": "Approximate token budget for each explanation request (the diff plus surrounding code and definitions). Lower it to save tokens; context is dropped least-useful first."
        },
        "patchTutor.maxOutputTokens": {
          "type": "number",
          "default": 1200,
          "minimum": 200,
          "maximum": 8000,
          "markdownDescription": "Approximate maximum length of each explanation, in tokens."
        },
        "patchTutor.gutterIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the Patch Tutor icon in the gutter on each changed hunk that Patch Tutor can explain."
        },
        "patchTutor.highlightChangedLines": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Softly highlight lines Patch Tutor can explain, and mark them in the scrollbar. Hover a highlighted line for Explain and Quiz me buttons. Colors can be changed with `workbench.colorCustomizations` (`patchTutor.changedLineBackground`, `patchTutor.changedLineRuler`)."
        },
        "patchTutor.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Server URL for the **OpenAI-compatible** provider (for example `https://api.openai.com/v1`, `https://openrouter.ai/api/v1` or `http://localhost:1234/v1` for LM Studio) or for **Ollama** (default `http://localhost:11434`). Not used by VS Code models or Anthropic."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "patchTutor.dev.runPromptEvals",
          "when": "patchTutor.devMode"
        },
        {
          "command": "patchTutor.explainHunk",
          "when": "false"
        },
        {
          "command": "patchTutor.quizHunk",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.deeper",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.simpler",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.quiz",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.dismiss",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.submit",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.showAnswer",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.skip",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.reportWrong",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.moveToChat",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "patchTutor.thread.simpler",
          "group": "inline@1",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread (standard|deep)\\b/"
        },
        {
          "command": "patchTutor.thread.deeper",
          "group": "inline@2",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread (simple|standard)\\b/"
        },
        {
          "command": "patchTutor.thread.quiz",
          "group": "inline@3",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread/"
        },
        {
          "command": "patchTutor.quiz.moveToChat",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/",
          "group": "inline@4"
        },
        {
          "command": "patchTutor.thread.reportWrong",
          "group": "inline@5",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread/"
        },
        {
          "command": "patchTutor.thread.dismiss",
          "group": "inline@6",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "patchTutor.quiz.submit",
          "group": "inline@1",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        },
        {
          "command": "patchTutor.quiz.showAnswer",
          "group": "inline@2",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        },
        {
          "command": "patchTutor.quiz.skip",
          "group": "inline@3",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        },
        {
          "command": "patchTutor.quiz.moveToChat",
          "group": "inline@4",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        }
      ],
      "view/title": [
        {
          "command": "patchTutor.resetProgress",
          "when": "view == patchTutor.progress",
          "group": "navigation@1"
        },
        {
          "command": "patchTutor.openModelSettings",
          "when": "view == patchTutor.chat",
          "group": "navigation@1"
        }
      ]
    },
    "colors": [
      {
        "id": "patchTutor.changedLineBackground",
        "description": "Background of changed lines Patch Tutor can explain.",
        "defaults": {
          "dark": "#F5C5181A",
          "light": "#F5C51826",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "patchTutor.changedLineRuler",
        "description": "Scrollbar marker for changed lines Patch Tutor can explain.",
        "defaults": {
          "dark": "#F5C518B3",
          "light": "#D4A500B3",
          "highContrast": "#F5C518",
          "highContrastLight": "#8A6D00"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patchTutor",
          "title": "Patch Tutor",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "patchTutor": [
        {
          "type": "webview",
          "id": "patchTutor.chat",
          "name": "Quiz chat",
          "icon": "media/activitybar.svg",
          "contextualTitle": "Patch Tutor"
        },
        {
          "type": "webview",
          "id": "patchTutor.progress",
          "name": "Progress",
          "icon": "media/activitybar.svg",
          "contextualTitle": "Patch Tutor"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.6",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "markdown-it": "^15.0.2",
    "parse-diff": "^0.12.0",
    "zod": "^4.6.5"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
