{
  "name": "patch-tutor",
  "displayName": "Patch Tutor",
  "description": "Turns your git changes into short lessons: inline explanations and quizzes on the code you changed.",
  "version": "0.0.1",
  "publisher": "patch-tutor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/patch-tutor"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "patchTutor.listStagedHunks",
        "title": "List staged hunks",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.explainStagedChanges",
        "title": "Explain staged changes",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.chooseProvider",
        "title": "Choose provider",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.chooseModel",
        "title": "Choose model",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.testConnection",
        "title": "Test connection",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.dev.runPromptEvals",
        "title": "Run prompt evals (dev)",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.explainHunk",
        "title": "Explain this change",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quizHunk",
        "title": "Quiz me",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.thread.deeper",
        "title": "Go deeper",
        "category": "Patch Tutor",
        "icon": "$(zoom-in)"
      },
      {
        "command": "patchTutor.thread.simpler",
        "title": "Simpler",
        "category": "Patch Tutor",
        "icon": "$(zoom-out)"
      },
      {
        "command": "patchTutor.thread.quiz",
        "title": "Quiz me",
        "category": "Patch Tutor",
        "icon": "$(mortar-board)"
      },
      {
        "command": "patchTutor.thread.dismiss",
        "title": "Dismiss",
        "category": "Patch Tutor",
        "icon": "$(close)"
      },
      {
        "command": "patchTutor.quiz.submit",
        "title": "Submit answer",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quiz.showAnswer",
        "title": "Show answer",
        "category": "Patch Tutor"
      },
      {
        "command": "patchTutor.quiz.skip",
        "title": "Skip",
        "category": "Patch Tutor"
      }
    ],
    "configuration": {
      "title": "Patch Tutor",
      "properties": {
        "patchTutor.provider": {
          "type": "string",
          "enum": [
            "vscodeLm"
          ],
          "enumItemLabels": [
            "GitHub Copilot"
          ],
          "enumDescriptions": [
            "Copilot models through VS Code. No API key needed."
          ],
          "default": "vscodeLm",
          "markdownDescription": "Which language model provider explains and quizzes your changes. Use **Patch Tutor: Choose provider** to change it."
        },
        "patchTutor.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model id or family for the provider. Leave empty to use the provider's default. Use **Patch Tutor: Choose model** to pick from the available models."
        },
        "patchTutor.contextTokenBudget": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 100000,
          "markdownDescription": "Approximate token budget for each explanation request (the diff plus surrounding code and definitions). Lower it to save tokens; context is dropped least-useful first."
        },
        "patchTutor.maxOutputTokens": {
          "type": "number",
          "default": 1200,
          "minimum": 200,
          "maximum": 8000,
          "markdownDescription": "Approximate maximum length of each explanation, in tokens."
        },
        "patchTutor.gutterIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a lightbulb in the gutter on each changed hunk that Patch Tutor can explain."
        },
        "patchTutor.highlightChangedLines": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Softly highlight lines Patch Tutor can explain, and mark them in the scrollbar. Hover a highlighted line for Explain and Quiz me buttons. Colors can be changed with `workbench.colorCustomizations` (`patchTutor.changedLineBackground`, `patchTutor.changedLineRuler`)."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "patchTutor.dev.runPromptEvals",
          "when": "patchTutor.devMode"
        },
        {
          "command": "patchTutor.explainHunk",
          "when": "false"
        },
        {
          "command": "patchTutor.quizHunk",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.deeper",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.simpler",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.quiz",
          "when": "false"
        },
        {
          "command": "patchTutor.thread.dismiss",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.submit",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.showAnswer",
          "when": "false"
        },
        {
          "command": "patchTutor.quiz.skip",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "patchTutor.thread.simpler",
          "group": "inline@1",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread (standard|deep)\\b/"
        },
        {
          "command": "patchTutor.thread.deeper",
          "group": "inline@2",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread (simple|standard)\\b/"
        },
        {
          "command": "patchTutor.thread.quiz",
          "group": "inline@3",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread/"
        },
        {
          "command": "patchTutor.thread.dismiss",
          "group": "inline@4",
          "when": "commentController == patch-tutor && commentThread =~ /^patchTutorThread/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "patchTutor.quiz.submit",
          "group": "inline@1",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        },
        {
          "command": "patchTutor.quiz.showAnswer",
          "group": "inline@2",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        },
        {
          "command": "patchTutor.quiz.skip",
          "group": "inline@3",
          "when": "commentController == patch-tutor && commentThread =~ /\\bquiz$/"
        }
      ]
    },
    "colors": [
      {
        "id": "patchTutor.changedLineBackground",
        "description": "Background of changed lines Patch Tutor can explain.",
        "defaults": {
          "dark": "#F5C5181A",
          "light": "#F5C51826",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "patchTutor.changedLineRuler",
        "description": "Scrollbar marker for changed lines Patch Tutor can explain.",
        "defaults": {
          "dark": "#F5C518B3",
          "light": "#D4A500B3",
          "highContrast": "#F5C518",
          "highContrastLight": "#8A6D00"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "parse-diff": "^0.12.0",
    "zod": "^4.6.5"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
