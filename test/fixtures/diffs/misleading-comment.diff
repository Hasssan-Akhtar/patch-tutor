diff --git a/src/api/post/controllers/post.ts b/src/api/post/controllers/post.ts
index 3333333..4444444 100644
--- a/src/api/post/controllers/post.ts
+++ b/src/api/post/controllers/post.ts
@@ -1,3 +1,14 @@
 import { factories } from '@strapi/strapi'
 
-export default factories.createCoreController('api::post.post')
+export default factories.createCoreController('api::post.post', () => ({
+  /**
+   * Newest posts first unless the caller asks for a specific order — the
+   * blog index relies on this and never passes `sort` itself.
+   */
+  async find(ctx) {
+    if (!ctx.query.sort) {
+      ctx.query = { ...ctx.query, sort: ['publishedAt:desc'] }
+    }
+    return super.find(ctx)
+  },
+}))
